{
  "name": "h1n1",
  "private": true,
  "version": "0.1.0",
  "description": "H1N1 Infection Journey: an interactive 3D anatomy and simulation experience",
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @h1n1/simulator dev",
    "start": "pnpm --filter @h1n1/simulator start",
    "preview": "pnpm --filter @h1n1/simulator preview",
    "build": "pnpm --filter @h1n1/simulator build",
    "test": "pnpm --filter @h1n1/simulator test",
    "test:e2e": "pnpm --filter @h1n1/simulator test:e2e",
    "typecheck": "pnpm --filter @h1n1/simulator typecheck",
    "legacy:build": "pnpm -r --filter './packages/**' build && pnpm -r --filter @h1n1/api --filter @h1n1/web build",
    "legacy:test": "pnpm -r --filter '!@h1n1/simulator' test",
    "web": "pnpm --filter @h1n1/simulator dev",
    "legacy:db:migrate": "pnpm --filter @h1n1/db migrate",
    "legacy:db:seed": "pnpm --filter @h1n1/db seed",
    "legacy:ingest": "pnpm --filter @h1n1/connectors ingest",
    "legacy:api": "pnpm --filter @h1n1/api dev",
    "legacy:web": "pnpm --filter @h1n1/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
