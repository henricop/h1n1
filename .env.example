# Deixe vazio para usar PGlite (Postgres embutido) em ./data/pglite
DATABASE_URL=
# Porta da API
API_PORT=3001
# URL da API consumida pelo site
NEXT_PUBLIC_API_URL=http://localhost:3001
# Diretório de snapshots originais
SNAPSHOT_DIR=./data/snapshots
# Limite de linhas para ingestão SIVEP em desenvolvimento (vazio = arquivo completo)
SIVEP_MAX_ROWS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
